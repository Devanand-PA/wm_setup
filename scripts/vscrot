#!/usr/bin/python3
import sys
import subprocess
ARGS = sys.argv
if (len(ARGS) > 1) :
    ARG = ARGS[1]
else :
    ARG = ""
IMG = ""
if ("U" in ARG) :
    IMG=subprocess.check_output("sel_img --gallery -t $(find $HOME/Pictures/Screenshots -type d)",shell=True,text=True).rstrip()

elif ("N" in ARG) :
    IMG=subprocess.check_output("sel_img --gallery -t $(find $HOME/Pictures/Named_Screenshots -type d)",shell=True,text=True).rstrip()

if not IMG :
    IMG = subprocess.check_output("sel_img --gallery -t $(find $HOME/Pictures/*Screenshots -type d)",shell=True,text=True).rstrip()

imgargs = []
if IMG :
    print(IMG)
    if "I" in ARG :
        imgs = list(IMG.split("\n"))
        if len(imgs)>1 :
            imgargs = ['-t']
        subprocess.run(['sxiv']+imgargs+imgs)
