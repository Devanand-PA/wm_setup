#!/usr/bin/env python3
"""
High-performance image selector with async loading, thumbnail caching,
lazy directory scanning, and multi-select support. (Qt port)

Usage:
    sel_img.py [directory...] [-r] [-t]
    -r  : recursively search subdirectories
    -t  : sort by modification time (newest first)

Dmenu mode:
    sel_img.py --dmenu-mode --list-file FILE --image-file FILE
    sel_img.py --dmenu-mode --list-entries "a\nb" --image-entries "1.png\n2.png"
    --return-label  : output the label instead of the image path (dmenu only)

Multi-select:
    <Control-Return>  : select / deselect current item
    <Return>          : confirm — prints all selected items + current item

Views:
    <Control-g>       : toggle between list view and gallery view
    <Tab>             : toggle between list view and gallery view
    --gallery-rows N  : target number of gallery rows visible (default 3.5)
    --gallery-cols N  : target number of gallery columns visible
    --gallery-tile-size N : explicit gallery tile size in pixels (overrides rows/cols)
    --gallery-aspect N    : tile width/height ratio (default: auto-detected
                            from the images, so screenshots fill their tiles)

Pre-select:
    --pre-select "entry1\nentry2"      : pre-select labels at launch
    --pre-select-file FILE             : read pre-select labels from file

Performance notes:
  * Uses pyvips (libvips) when available — the same C library GdkPixbuf wraps.
    Falls back to PIL with draft()/reduce()/BILINEAR + reducing_gap.
  * Persistent on-disk WebP thumbnail cache under ~/.cache/sel_img_thumbs.
  * Decode workers are threads; libvips/libjpeg-turbo release the GIL inside
    their C decode+resize paths, so this scales well up to cpu_count workers.
"""

import sys
import os
import hashlib
import argparse
import threading
import queue
from pathlib import Path

from PySide6.QtCore import (
    Qt, QTimer, QObject, Signal, QSize, QPoint, QRect, QEvent
)
from PySide6.QtGui import (
    QPixmap, QImage, QKeySequence, QShortcut, QColor
)
from PySide6.QtWidgets import (
    QApplication, QWidget, QVBoxLayout, QHBoxLayout, QListWidget,
    QListWidgetItem, QLineEdit, QLabel, QScrollArea, QFrame,
    QSizePolicy, QStackedWidget, QAbstractItemView, QMainWindow,
    QStyle, QStyledItemDelegate, QStyleOptionViewItem
)

# ── Optional fast-path decoders ──────────────────────────────────────────────
try:
    import pyvips  # type: ignore
    HAS_VIPS = True
except Exception:
    HAS_VIPS = False

try:
    import numpy as np  # noqa: F401
    HAS_NUMPY = True
except Exception:
    HAS_NUMPY = False

from PIL import Image, ImageFile
ImageFile.LOAD_TRUNCATED_IMAGES = True

# ─── Configuration ───────────────────────────────────────────────────────────

SUPPORTED_EXTS = {'.png', '.jpg', '.jpeg', '.gif', '.bmp', '.webp', '.tiff', '.tif'}

THEME = {
    "bg_primary":   "#2e3440",
    "bg_secondary": "#3b4252",
    "bg_input":     "#4c566a",
    "fg_text":      "#d8dee9",
    "fg_bright":    "#eceff4",
    "accent":       "#88c0d0",
    "accent_fg":    "#2e3440",
    "selected_bg":  "#5e81ac",
    "selected_fg":  "#eceff4",
    "hover_border": "#4c566a",
}

CACHE_SIZE = 800
PRELOAD_AHEAD = 3

DECODE_WORKERS = max(2, min(8, os.cpu_count() or 4))

DISK_CACHE_ENABLED = True
CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME", "~/.cache")).expanduser() / "sel_img_thumbs"
CACHE_WEBP_QUALITY = 82

# Gallery geometry — tile size scales with viewport size at runtime.
# Tiles are NOT forced square: width and height are derived independently
# from the (auto-detected or user-supplied) target aspect ratio.
GALLERY_TILE_MIN = 180           # bounds on the tile's *long* dimension
GALLERY_TILE_MAX = 420
GALLERY_TARGET_ROWS = 3.5        # approx rows we want visible in the viewport
GALLERY_CAPTION_RATIO = 0.16     # caption height as fraction of tile height
GALLERY_CAPTION_MIN = 22
GALLERY_PAD_RATIO = 0.045        # inter-tile pad as fraction of tile height
GALLERY_PAD_MIN = 6
GALLERY_SIZE_QUANTUM = 8         # quantize tile size to reduce rebuild churn
GALLERY_OVERSCAN_ROWS = 2

# Default tile aspect ratio (width / height) when the images give us no clue.
GALLERY_ASPECT_DEFAULT = 16.0 / 9.0
GALLERY_ASPECT_MIN = 0.4
GALLERY_ASPECT_MAX = 3.0
GALLERY_ASPECT_SAMPLE = 20       # how many leading items to sample


# ─── Decode helpers (module-level, run on worker threads) ────────────────────

def _get_orig_size(path):
    """Cheap header-only read. Does not decode pixel data."""
    try:
        with Image.open(path) as img:
            return img.size
    except Exception:
        return (0, 0)


def _disk_cache_path(path, w, h):
    try:
        st = os.stat(path)
    except OSError:
        return None
    key = hashlib.sha1(
        f"{path}|{st.st_mtime_ns}|{st.st_size}|{w}x{h}".encode("utf-8")
    ).hexdigest()
    return CACHE_DIR / key[:2] / (key + ".webp")


def _decode_image(path, max_w, max_h):
    """Decode/thumbnail `path` to fit inside (max_w, max_h).

    Returns (PIL.Image or None, (orig_w, orig_h)).
    Uses the on-disk WebP cache when possible.
    """
    orig_size = _get_orig_size(path)

    cache_file = _disk_cache_path(path, max_w, max_h) if DISK_CACHE_ENABLED else None

    # ── 1) On-disk cache hit ──
    if cache_file is not None and cache_file.exists():
        try:
            with Image.open(cache_file) as img:
                img.load()
                return img, orig_size
        except Exception:
            try:
                cache_file.unlink()
            except OSError:
                pass

    pil_img = None

    # ── 2) pyvips fast path ──
    if HAS_VIPS and HAS_NUMPY:
        try:
            v = pyvips.Image.thumbnail(path, max_w, height=max_h, size="down")
            arr = v.numpy()
            if v.bands == 4:
                pil_img = Image.fromarray(arr.copy(), "RGBA")
            elif v.bands == 3:
                pil_img = Image.fromarray(arr.copy(), "RGB")
            else:
                pil_img = Image.fromarray(arr.copy()).convert("RGB")
        except Exception:
            pil_img = None

    # ── 3) PIL fallback ──
    if pil_img is None:
        try:
            with Image.open(path) as img:
                # Ask libjpeg for a pre-scaled decode (huge win on big JPEGs).
                if img.format == "JPEG":
                    img.draft("RGB", (max_w, max_h))

                # Box-filter pre-shrink for very large images (cheap O(n)).
                if img.width > max_w * 4 or img.height > max_h * 4:
                    factor = max(1, min(img.width // (max_w * 2),
                                        img.height // (max_h * 2)))
                    if factor > 1:
                        img = img.reduce(factor)

                # BILINEAR + reducing_gap is 2-3x faster than LANCZOS and
                # visually identical at thumbnail sizes.
                img.thumbnail((max_w, max_h),
                              Image.Resampling.BILINEAR,
                              reducing_gap=2.0)

                if img.mode not in ("RGB", "RGBA"):
                    img = img.convert("RGBA" if "A" in img.mode else "RGB")

                img.load()
                pil_img = img
        except Exception:
            pil_img = None

    # ── 4) Populate the on-disk cache ──
    if pil_img is not None and cache_file is not None:
        tmp = None
        try:
            cache_file.parent.mkdir(parents=True, exist_ok=True)
            tmp = cache_file.with_name(cache_file.name + ".tmp")
            pil_img.save(tmp, "WEBP", quality=CACHE_WEBP_QUALITY, method=0)
            os.replace(tmp, cache_file)
        except Exception:
            if tmp is not None:
                try:
                    tmp.unlink()
                except Exception:
                    pass

    return pil_img, orig_size


def _pil_to_qpixmap(pil_img):
    """Convert a PIL image to a QPixmap. Must be called on the GUI thread."""
    if pil_img is None:
        return None
    try:
        if pil_img.mode not in ("RGB", "RGBA"):
            pil_img = pil_img.convert("RGBA" if "A" in pil_img.mode else "RGB")
        w, h = pil_img.size
        if pil_img.mode == "RGBA":
            data = pil_img.tobytes("raw", "RGBA")
            fmt = QImage.Format_RGBA8888
            bpl = w * 4
        else:
            data = pil_img.tobytes("raw", "RGB")
            fmt = QImage.Format_RGB888
            bpl = w * 3
        qimg = QImage(data, w, h, bpl, fmt)
        return QPixmap.fromImage(qimg.copy())
    except Exception:
        return None


# ─── Bridge objects for cross-thread signalling ──────────────────────────────

class _DecodeBridge(QObject):
    done = Signal(object, object, object, object)   # pil_img, token, orig_size, callback


class _ScanBridge(QObject):
    file_found = Signal(str)


# ─── Custom list delegate ────────────────────────────────────────────────────

class _ListItemDelegate(QStyledItemDelegate):
    """Draws list rows with colours matching the Tk original: current row
    uses the accent colour, pre-selected rows use the 'selected' colour,
    everything else uses the secondary background."""

    def __init__(self, app):
        super().__init__()
        self.app = app

    def paint(self, painter, option, index):
        painter.save()
        rect = option.rect
        path = index.data(Qt.UserRole)
        is_current = bool(option.state & QStyle.State_Selected)
        is_preselected = path in self.app.selected_paths

        if is_current:
            bg = QColor(THEME["accent"])
            fg = QColor(THEME["accent_fg"])
        elif is_preselected:
            bg = QColor(THEME["selected_bg"])
            fg = QColor(THEME["selected_fg"])
        else:
            bg = QColor(THEME["bg_secondary"])
            fg = QColor(THEME["fg_text"])

        painter.fillRect(rect, bg)
        painter.setPen(fg)
        text = index.data(Qt.DisplayRole) or ""
        painter.drawText(rect.adjusted(8, 0, -8, 0),
                         Qt.AlignVCenter | Qt.AlignLeft, text)
        painter.restore()

    def sizeHint(self, option, index):
        s = super().sizeHint(option, index)
        s.setHeight(max(s.height(), 22))
        return s


# ─── Search entry ────────────────────────────────────────────────────────────

class SearchEntry(QLineEdit):
    """Line edit that forwards navigation/confirm keys to the app."""

    def __init__(self, app, parent=None):
        super().__init__(parent)
        self.app = app

    def keyPressEvent(self, event):
        app = self.app
        key = event.key()
        mods = event.modifiers()
        ctrl = bool(mods & Qt.ControlModifier)

        if key in (Qt.Key_Return, Qt.Key_Enter):
            if ctrl:
                app._on_ctrl_return()
            else:
                app._on_confirm()
            event.accept()
            return
        if key == Qt.Key_Escape:
            app._on_cancel()
            event.accept()
            return
        if key == Qt.Key_C and ctrl:
            app._on_ctl_c()
            event.accept()
            return
        if key == Qt.Key_Tab:
            app._toggle_view()
            event.accept()
            return
        if key == Qt.Key_G and ctrl:
            app._toggle_view()
            event.accept()
            return
        if key == Qt.Key_Up:
            app._nav_up()
            event.accept()
            return
        if key == Qt.Key_Down:
            app._nav_down()
            event.accept()
            return
        if key == Qt.Key_Left and app.view_mode == "gallery":
            app._nav_left()
            event.accept()
            return
        if key == Qt.Key_Right and app.view_mode == "gallery":
            app._nav_right()
            event.accept()
            return
        if key == Qt.Key_PageUp and app.view_mode == "gallery":
            app._gallery_page(-1)
            event.accept()
            return
        if key == Qt.Key_PageDown and app.view_mode == "gallery":
            app._gallery_page(1)
            event.accept()
            return
        super().keyPressEvent(event)


# ─── Gallery tile ────────────────────────────────────────────────────────────

class GalleryTile(QFrame):
    """A single thumbnail + caption tile in the gallery view."""

    def __init__(self, parent, app, index, label, path):
        super().__init__(parent)
        self.setObjectName("galleryTile")
        self.setAttribute(Qt.WA_StyledBackground, True)
        self.setFocusPolicy(Qt.NoFocus)

        self.app = app
        self.index = index
        self.label = label
        self.path = path
        self._pixmap = None
        self._selected = False
        self._current = False

        layout = QVBoxLayout(self)
        layout.setContentsMargins(2, 2, 2, 2)
        layout.setSpacing(0)

        self.thumb = QLabel(self)
        self.thumb.setAlignment(Qt.AlignCenter)
        self.thumb.setText("…")
        self.thumb.setSizePolicy(QSizePolicy.Ignored, QSizePolicy.Ignored)
        self.thumb.setMinimumSize(1, 1)
        self.thumb.setAttribute(Qt.WA_TransparentForMouseEvents, True)
        self.thumb.setStyleSheet(
            f"background-color: {THEME['bg_secondary']}; color: {THEME['fg_text']};"
        )
        layout.addWidget(self.thumb, 1)

        self.caption = QLabel(label, self)
        self.caption.setAlignment(Qt.AlignCenter)
        self.caption.setWordWrap(True)
        self.caption.setAttribute(Qt.WA_TransparentForMouseEvents, True)
        self.caption.setStyleSheet(
            f"background-color: {THEME['bg_secondary']}; "
            f"color: {THEME['fg_text']}; font-size: 9px;"
        )
        # Match the Tk behaviour: caption occupies a fixed slice of the tile.
        try:
            self.caption.setFixedHeight(max(1, int(app._tile_caption_h)))
        except Exception:
            self.caption.setFixedHeight(22)
        layout.addWidget(self.caption, 0)

        self._refresh_border()

    # ── mouse events ──
    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            self.app._select_and_show(self.index, from_gallery=True)
            self.app.input.setFocus()
            event.accept()
            return
        super().mousePressEvent(event)

    def mouseDoubleClickEvent(self, event):
        if event.button() == Qt.LeftButton:
            self.app._select_and_show(self.index, from_gallery=True)
            self.app._on_confirm()
            event.accept()
            return
        super().mouseDoubleClickEvent(event)

    def enterEvent(self, event):
        if not self._selected and not self._current:
            self.setStyleSheet(
                f"QFrame#galleryTile {{ background-color: {THEME['bg_secondary']}; "
                f"border: 2px solid {THEME['hover_border']}; }}"
            )
        super().enterEvent(event)

    def leaveEvent(self, event):
        self._refresh_border()
        super().leaveEvent(event)

    # ── public API ──
    def set_photo(self, pixmap):
        self._pixmap = pixmap
        if pixmap is not None and not pixmap.isNull():
            self.thumb.setPixmap(pixmap)
            self.thumb.setText("")
        else:
            self.thumb.setPixmap(QPixmap())
            self.thumb.setText("✕")

    def update_item(self, index, label, path):
        """Recycle this tile. Returns True if the path changed."""
        self.index = index
        if self.path == path:
            if self.label != label:
                self.label = label
                self.caption.setText(label)
            return False
        self.label = label
        self.path = path
        self.caption.setText(label)
        self._pixmap = None
        self.thumb.setPixmap(QPixmap())
        self.thumb.setText("…")
        return True

    def set_selected(self, selected):
        if self._selected == selected:
            return
        self._selected = selected
        self._refresh_border()

    def set_current(self, current):
        if self._current == current:
            return
        self._current = current
        self._refresh_border()

    def _refresh_border(self):
        if self._selected:
            color = THEME["selected_bg"]
            width = 3
        elif self._current:
            color = THEME["accent"]
            width = 2
        else:
            color = THEME["bg_secondary"]
            width = 2
        self.setStyleSheet(
            f"QFrame#galleryTile {{ background-color: {THEME['bg_secondary']}; "
            f"border: {width}px solid {color}; }}"
        )


# ─── Gallery scroll area ─────────────────────────────────────────────────────

class _GalleryScrollArea(QScrollArea):
    resized = Signal()

    def resizeEvent(self, event):
        super().resizeEvent(event)
        self.resized.emit()


# ─── Main application ────────────────────────────────────────────────────────

class ImageSelector(QMainWindow):

    def __init__(self, image_paths, display_labels=None,
                 pre_select_labels=None, pass_idx=0, idx_write_path="",
                 custom_title="", gallery_rows=None, gallery_cols=None,
                 gallery_tile_size=None, gallery_aspect=None):
        super().__init__()

        self._gallery_rows_opt = gallery_rows if gallery_rows and gallery_rows > 0 else None
        self._gallery_cols_opt = gallery_cols if gallery_cols and gallery_cols > 0 else None
        self._gallery_tile_opt = (gallery_tile_size
                                  if gallery_tile_size and gallery_tile_size > 0
                                  else None)
        self._gallery_aspect_opt = (gallery_aspect
                                    if gallery_aspect and gallery_aspect > 0
                                    else None)
        self._gallery_aspect_cache = None

        self.idx_write_path = idx_write_path
        self.custom_title = custom_title

        if display_labels is None:
            self.all_items = [(os.path.basename(p), p) for p in image_paths]
        else:
            if len(display_labels) != len(image_paths):
                raise ValueError("display_labels and image_paths must have same length")
            self.all_items = list(zip(display_labels, image_paths))

        self.filtered_items = self.all_items.copy()
        self.path_to_abs_index = {path: idx for idx, (_, path) in enumerate(self.all_items)}

        self._closing = False
        self._last_index = -1
        self._scan_thread = None
        self._scan_done = threading.Event()
        self._scan_done.set()
        self.selected_path = None
        self.selected_label = None
        self.selected_paths = set()
        self.selected_paths_list = []
        self.selected_labels_list = []
        self._base_status_text = ""
        self._suppress_list_signal = False

        # View state
        self.view_mode = "list"

        # Gallery metrics — recomputed from the viewport size.
        self._tile_w = 240
        self._tile_h = 240
        self._tile_caption_h = 34
        self._tile_pad = 10
        self._tile_thumb_max = (self._tile_w - 5, self._tile_h - 5)
        self._gallery_tiles = {}
        self._gallery_cols = 1
        self._gallery_grid_dirty = True
        self._gallery_built = False
        self._pending_gallery_scroll = None
        self._gallery_gen = 0

        # Decode infrastructure
        self._decode_q = queue.Queue()
        self._decode_tokens = {}
        self._decode_token_lock = threading.Lock()
        self._decode_token_counter = 0
        self._decode_threads = []
        self._decode_stop = threading.Event()

        self._decode_bridge = _DecodeBridge()
        self._decode_bridge.done.connect(self._on_decode_done, Qt.QueuedConnection)

        self._scan_bridge = _ScanBridge()
        self._scan_bridge.file_found.connect(self._append_to_list, Qt.QueuedConnection)

        self._pil_cache = {}
        self._photo_cache = {}      # key=(path,w,h) -> (QPixmap, (orig_w, orig_h))
        self._cache_lock = threading.Lock()

        if pre_select_labels:
            self._apply_pre_select(pre_select_labels)

        self._setup_window()
        self._build_ui()
        self._start_decode_workers()
        self._populate_list()
        if self.filtered_items:
            self._select_and_show(pass_idx)
        self.input.setFocus()

    # ── Decode pool ──────────────────────────────────────────────────────────

    def _start_decode_workers(self):
        for _ in range(DECODE_WORKERS):
            t = threading.Thread(target=self._decode_worker, daemon=True)
            t.start()
            self._decode_threads.append(t)

    def _decode_worker(self):
        while not self._decode_stop.is_set():
            try:
                job = self._decode_q.get(timeout=0.25)
            except queue.Empty:
                continue
            if job is None:
                break
            path, max_w, max_h, token, callback = job
            if self._closing or self._decode_stop.is_set():
                continue
            with self._decode_token_lock:
                latest = self._decode_tokens.get(path)
            if latest is not None and latest != token:
                continue

            pil_img, orig_size = _decode_image(path, max_w, max_h)

            if self._closing or self._decode_stop.is_set():
                continue
            try:
                self._decode_bridge.done.emit(pil_img, token, orig_size, callback)
            except Exception:
                pass

    def _on_decode_done(self, pil_img, token, orig_size, callback):
        if self._closing:
            return
        try:
            callback(pil_img, token, orig_size)
        except Exception:
            pass

    def _request_decode(self, path, max_w, max_h, callback):
        with self._decode_token_lock:
            self._decode_token_counter += 1
            token = self._decode_token_counter
            self._decode_tokens[path] = token
        self._decode_q.put((path, max_w, max_h, token, callback))
        return token

    # ── Thumbnail cache ──────────────────────────────────────────────────────

    def _cache_get(self, path, w, h):
        key = (path, w, h)
        with self._cache_lock:
            entry = self._photo_cache.get(key)
            if entry is not None:
                self._photo_cache.pop(key, None)
                self._photo_cache[key] = entry
            return entry

    def _cache_put(self, path, w, h, entry):
        key = (path, w, h)
        with self._cache_lock:
            self._photo_cache[key] = entry
            while len(self._photo_cache) > CACHE_SIZE:
                oldest = next(iter(self._photo_cache))
                del self._photo_cache[oldest]

    def _load_thumbnail_async(self, path, w, h, on_ready):
        cached = self._cache_get(path, w, h)
        if cached is not None:
            pixmap, orig_size = cached
            on_ready(pixmap, orig_size)
            return pixmap

        def _done(pil_img, token, orig_size):
            if self._closing:
                return
            if pil_img is None:
                on_ready(None, orig_size)
                return
            pixmap = _pil_to_qpixmap(pil_img)
            if pixmap is None:
                on_ready(None, orig_size)
                return
            self._cache_put(path, w, h, (pixmap, orig_size))
            on_ready(pixmap, orig_size)

        self._request_decode(path, w, h, _done)
        return None

    # ── Pre-select ───────────────────────────────────────────────────────────

    def _apply_pre_select(self, pre_select_labels):
        target_labels = set(pre_select_labels)
        matched = set()
        for label, path in self.all_items:
            if label in target_labels and label not in matched:
                self.selected_paths.add(path)
                matched.add(label)

    # ── Window / UI ──────────────────────────────────────────────────────────

    def _setup_window(self):
        self.setWindowTitle(self.custom_title or "Image Selector")
        self.setWindowFlags(Qt.Dialog | Qt.WindowStaysOnTopHint)
        screen = QApplication.primaryScreen()
        if screen is not None:
            geo = screen.availableGeometry()
            self.setGeometry(geo.x() + 50, geo.y() + 50,
                             max(600, geo.width() - 100),
                             max(400, geo.height() - 100))
        else:
            self.setGeometry(50, 50, 1200, 800)
        self.setMinimumSize(600, 400)

        self.setStyleSheet(
            f"QMainWindow {{ background-color: {THEME['bg_primary']}; }}"
        )

    def _build_ui(self):
        central = QWidget()
        central.setObjectName("mainRoot")
        central.setAttribute(Qt.WA_StyledBackground, True)
        central.setStyleSheet(
            f"#mainRoot {{ background-color: {THEME['bg_primary']}; }}"
        )
        self.setCentralWidget(central)

        root_layout = QVBoxLayout(central)
        root_layout.setContentsMargins(10, 10, 10, 10)
        root_layout.setSpacing(5)

        # ── Stacked content ──
        self.stack = QStackedWidget()

        # --- List view page ---
        list_page = QWidget()
        list_page.setAttribute(Qt.WA_StyledBackground, True)
        list_page.setStyleSheet(
            f"background-color: {THEME['bg_primary']};"
        )
        lh = QHBoxLayout(list_page)
        lh.setContentsMargins(0, 0, 0, 0)
        lh.setSpacing(10)

        # Left: list
        self.left_frame = QFrame()
        self.left_frame.setFixedWidth(300)
        self.left_frame.setStyleSheet(
            f"background-color: {THEME['bg_primary']};"
        )
        lv = QVBoxLayout(self.left_frame)
        lv.setContentsMargins(0, 0, 0, 0)
        lv.setSpacing(0)

        self.listbox = QListWidget()
        self.listbox.setSelectionMode(QAbstractItemView.SingleSelection)
        self.listbox.setFocusPolicy(Qt.NoFocus)
        self.listbox.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        self.listbox.setUniformItemSizes(False)
        self.listbox.setStyleSheet(f"""
            QListWidget {{
                background-color: {THEME['bg_secondary']};
                color: {THEME['fg_text']};
                border: none;
                outline: none;
                font-size: 11px;
            }}
        """)
        self.listbox.setItemDelegate(_ListItemDelegate(self))
        lv.addWidget(self.listbox)

        # Right: preview
        self.right_frame = QFrame()
        self.right_frame.setStyleSheet(
            f"background-color: {THEME['bg_primary']};"
        )
        rv = QVBoxLayout(self.right_frame)
        rv.setContentsMargins(0, 0, 0, 0)
        rv.setSpacing(5)

        self.filename_label = QLabel()
        self.filename_label.setStyleSheet(
            f"background-color: transparent; color: {THEME['fg_bright']}; "
            f"font-size: 12px; font-weight: bold;"
        )
        rv.addWidget(self.filename_label, 0)

        self.image_container = QFrame()
        self.image_container.setObjectName("imageContainer")
        self.image_container.setAttribute(Qt.WA_StyledBackground, True)
        self.image_container.setStyleSheet(
            f"#imageContainer {{ background-color: {THEME['bg_secondary']}; }}"
        )
        ic_layout = QVBoxLayout(self.image_container)
        ic_layout.setContentsMargins(0, 0, 0, 0)

        self.image_label = QLabel()
        self.image_label.setAlignment(Qt.AlignCenter)
        self.image_label.setStyleSheet(
            f"background-color: transparent; color: {THEME['fg_text']};"
        )
        self.image_label.setText("Loading...")
        ic_layout.addWidget(self.image_label)

        rv.addWidget(self.image_container, 1)

        lh.addWidget(self.left_frame)
        lh.addWidget(self.right_frame, 1)

        self.stack.addWidget(list_page)

        # --- Gallery page ---
        self.gallery_frame = QFrame()
        self.gallery_frame.setStyleSheet(
            f"background-color: {THEME['bg_primary']};"
        )
        gv = QVBoxLayout(self.gallery_frame)
        gv.setContentsMargins(0, 0, 0, 0)
        gv.setSpacing(0)

        self.gallery_canvas = _GalleryScrollArea()
        self.gallery_canvas.setWidgetResizable(False)
        self.gallery_canvas.setFocusPolicy(Qt.NoFocus)
        self.gallery_canvas.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        self.gallery_canvas.setStyleSheet(f"""
            QScrollArea {{ background-color: {THEME['bg_primary']}; border: none; }}
            QScrollBar:vertical {{
                background-color: {THEME['bg_secondary']};
                width: 12px;
                border: none;
            }}
            QScrollBar::handle:vertical {{
                background-color: {THEME['bg_input']};
                min-height: 24px;
                border-radius: 4px;
            }}
            QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {{
                height: 0px;
            }}
        """)

        self.gallery_inner = QWidget()
        self.gallery_inner.setAttribute(Qt.WA_StyledBackground, True)
        self.gallery_inner.setStyleSheet(
            f"background-color: {THEME['bg_primary']};"
        )
        self.gallery_canvas.setWidget(self.gallery_inner)

        self.gallery_canvas.resized.connect(self._on_gallery_canvas_resize)
        self.gallery_canvas.verticalScrollBar().valueChanged.connect(
            self._on_gallery_scroll
        )

        gv.addWidget(self.gallery_canvas)
        self.stack.addWidget(self.gallery_frame)

        root_layout.addWidget(self.stack, 1)

        # ── Bottom bar ──
        bottom_bar = QWidget()
        bottom_bar.setAttribute(Qt.WA_StyledBackground, True)
        bottom_bar.setStyleSheet(
            f"background-color: {THEME['bg_primary']};"
        )
        bv = QVBoxLayout(bottom_bar)
        bv.setContentsMargins(0, 0, 0, 0)
        bv.setSpacing(4)

        self.status_label = QLabel()
        self.status_label.setAlignment(Qt.AlignRight)
        self.status_label.setStyleSheet(
            f"background-color: transparent; color: {THEME['fg_text']}; font-size: 10px;"
        )
        bv.addWidget(self.status_label)

        self.input = SearchEntry(self)
        self.input.setStyleSheet(f"""
            QLineEdit {{
                background-color: {THEME['bg_input']};
                color: {THEME['fg_text']};
                border: 1px solid {THEME['bg_secondary']};
                border-radius: 3px;
                padding: 4px 8px;
                font-size: 12px;
            }}
            QLineEdit:focus {{
                border: 1px solid {THEME['accent']};
            }}
        """)
        bv.addWidget(self.input)

        root_layout.addWidget(bottom_bar, 0)

        # ── Timers ──
        self._gallery_refresh_timer = QTimer(self)
        self._gallery_refresh_timer.setSingleShot(True)
        self._gallery_refresh_timer.timeout.connect(self._refresh_gallery)

        self._resize_timer = QTimer(self)
        self._resize_timer.setSingleShot(True)
        self._resize_timer.timeout.connect(self._on_resize_done)

        # ── Signals ──
        self.input.textChanged.connect(self._on_search)
        self.listbox.currentRowChanged.connect(self._on_list_current_changed)
        self.listbox.itemDoubleClicked.connect(lambda _it: self._on_confirm())

    # ── Refocus helpers ──────────────────────────────────────────────────────

    def _refocus_entry(self, event=None):
        self.input.setFocus()
        return "break"

    # ── Navigation dispatcher ────────────────────────────────────────────────

    def _nav_up(self):
        if self.view_mode == "gallery":
            self._gallery_move_up()
        else:
            self._focus_list_up()

    def _nav_down(self):
        if self.view_mode == "gallery":
            self._gallery_move_down()
        else:
            self._focus_list_down()

    def _nav_left(self):
        if self.view_mode == "gallery":
            self._gallery_move_left()

    def _nav_right(self):
        if self.view_mode == "gallery":
            self._gallery_move_right()

    # ── List population ──────────────────────────────────────────────────────

    def _populate_list(self):
        self._suppress_list_signal = True
        try:
            self.listbox.clear()
            for label, path in self.filtered_items:
                item = QListWidgetItem(label)
                item.setData(Qt.UserRole, path)
                self.listbox.addItem(item)
            if self.filtered_items:
                self.listbox.setCurrentRow(0)
        finally:
            self._suppress_list_signal = False
        self.listbox.viewport().update()

    def _append_to_list(self, path):
        if self._closing:
            return
        label = os.path.basename(path)
        self.all_items.append((label, path))
        self.filtered_items.append((label, path))
        idx = len(self.filtered_items) - 1
        item = QListWidgetItem(label)
        item.setData(Qt.UserRole, path)
        self.listbox.addItem(item)
        self.path_to_abs_index[path] = len(self.all_items) - 1

        # Re-sample the tile aspect ratio while we're still inside the sample
        # window (only when the user hasn't pinned it via --gallery-aspect).
        if (self._gallery_aspect_opt is None
                and len(self.all_items) <= GALLERY_ASPECT_SAMPLE):
            self._gallery_aspect_cache = None

        if self.view_mode == "gallery":
            self._reset_gallery_tiles()
            self._schedule_gallery_refresh()
        if idx == 0:
            self._select_and_show(0)

    # ── Search ───────────────────────────────────────────────────────────────

    def _on_search(self, text):
        query = (text or "").lower().strip()
        terms = query.split() if query else []

        self.filtered_items = [
            item for item in self.all_items
            if not terms or all(term in item[0].lower() for term in terms)
        ]

        self._populate_list()
        if self.filtered_items:
            self._last_index = -1
            self._select_and_show(0)
        else:
            self._last_index = -1
            self.filename_label.setText("No matches")
            self.image_label.setPixmap(QPixmap())
            self.image_label.setText("No matches")
            self._base_status_text = "No matches"
            self.status_label.setText(
                f"{self._base_status_text}  |  {len(self.selected_paths)} selected"
            )

        if self.view_mode == "gallery":
            self._schedule_gallery_refresh()

    def _reset_gallery_tiles(self):
        for tile in self._gallery_tiles.values():
            tile.setParent(None)
            tile.deleteLater()
        self._gallery_tiles.clear()
        self._gallery_gen += 1
        self._gallery_grid_dirty = True
        self._gallery_built = False

    # ── Selection & display ──────────────────────────────────────────────────

    def _on_list_current_changed(self, row):
        if self._suppress_list_signal:
            return
        if row < 0:
            return
        self._select_and_show(row)

    def _select_and_show(self, index, from_gallery=False):
        if not self.filtered_items:
            return
        index = max(0, min(index, len(self.filtered_items) - 1))
        if index == self._last_index and not from_gallery:
            return

        if self.idx_write_path:
            _, path = self.filtered_items[index]
            abs_idx = self.path_to_abs_index.get(path, -1)
            if abs_idx != -1:
                try:
                    with open(self.idx_write_path, 'w') as f:
                        f.write(str(abs_idx))
                except Exception:
                    pass

        self._suppress_list_signal = True
        try:
            self.listbox.setCurrentRow(index)
            item = self.listbox.item(index)
            if item is not None:
                self.listbox.scrollToItem(item)
        finally:
            self._suppress_list_signal = False

        self._last_index = index
        label, path = self.filtered_items[index]

        self._update_gallery_selection(index)
        self.listbox.viewport().update()

        if self.view_mode == "gallery":
            self._scroll_gallery_to(index)
            self._base_status_text = f"{index + 1} / {len(self.filtered_items)}"
            self.status_label.setText(
                f"{self._base_status_text}  |  {len(self.selected_paths)} selected"
            )
            return

        self.filename_label.setText(label)
        self.image_label.setPixmap(QPixmap())
        self.image_label.setText("Loading...")
        self._base_status_text = (
            f"Loading...  |  {index + 1} / {len(self.filtered_items)}"
        )
        self.status_label.setText(
            f"{self._base_status_text}  |  {len(self.selected_paths)} selected"
        )

        cw = max(self.image_container.width() - 20, 50)
        ch = max(self.image_container.height() - 20, 50)
        self._load_thumbnail_async(
            path, cw, ch,
            lambda pix, orig, i=index, p=path:
                self._on_preview_ready(i, p, pix, orig)
        )

        self._preload_neighbors(index)

    def _on_preview_ready(self, index, path, pixmap, orig_size):
        if self._closing or index != self._last_index:
            return
        if self.view_mode != "list":
            return
        if pixmap is None or pixmap.isNull():
            self.image_label.setPixmap(QPixmap())
            self.image_label.setText("Failed to load")
            self._base_status_text = "Error loading image"
        else:
            w, h = orig_size
            try:
                size_kb = os.path.getsize(path) / 1024
            except Exception:
                size_kb = 0
            self.image_label.setText("")
            self.image_label.setPixmap(pixmap)
            self._base_status_text = (
                f"{w}×{h}  |  {size_kb:.1f} KB  |  "
                f"{index + 1} / {len(self.filtered_items)}"
            )
        self.status_label.setText(
            f"{self._base_status_text}  |  {len(self.selected_paths)} selected"
        )

    def _preload_neighbors(self, center_index):
        if self._closing:
            return
        cw = max(self.image_container.width() - 20, 50)
        ch = max(self.image_container.height() - 20, 50)
        for offset in range(-PRELOAD_AHEAD, PRELOAD_AHEAD + 1):
            if offset == 0:
                continue
            idx = center_index + offset
            if 0 <= idx < len(self.filtered_items):
                _, path = self.filtered_items[idx]
                self._load_thumbnail_async(path, cw, ch,
                                           lambda pix, orig: None)

    def _on_resize_done(self):
        if self._closing:
            return
        if self._last_index >= 0 and self.filtered_items and self.view_mode == "list":
            self._select_and_show(self._last_index, from_gallery=True)

    # ── Navigation (list view) ───────────────────────────────────────────────

    def _focus_list_up(self):
        n = len(self.filtered_items)
        if n == 0:
            return
        curr = self.listbox.currentRow()
        idx = curr if curr >= 0 else 0
        self._select_and_show((idx - 1) % n)

    def _focus_list_down(self):
        n = len(self.filtered_items)
        if n == 0:
            return
        curr = self.listbox.currentRow()
        idx = curr if curr >= 0 else 0
        self._select_and_show((idx + 1) % n)

    # ── Multi-select ─────────────────────────────────────────────────────────

    def _on_ctrl_return(self):
        if not self.filtered_items or self._last_index < 0:
            return
        path = self.filtered_items[self._last_index][1]
        if path in self.selected_paths:
            self.selected_paths.discard(path)
        else:
            self.selected_paths.add(path)
        self.listbox.viewport().update()
        self._update_gallery_selection(self._last_index)
        self.status_label.setText(
            f"{self._base_status_text}  |  {len(self.selected_paths)} selected"
        )

    def _on_ctl_c(self):
        self.selected_path = None
        self.selected_label = None
        self.selected_paths = set()
        self.selected_paths_list = []
        self.selected_labels_list = []
        self._shutdown()
        QApplication.instance().exit(99)

    def _on_confirm(self):
        result_paths = []
        result_labels = []
        for label, path in self.all_items:
            if path in self.selected_paths and path not in result_paths:
                result_paths.append(path)
                result_labels.append(label)

        if self._last_index >= 0 and self.filtered_items:
            current_label, current_path = self.filtered_items[self._last_index]
            if current_path not in result_paths:
                result_paths.append(current_path)
                result_labels.append(current_label)
            self.selected_path = current_path
            self.selected_label = current_label
        else:
            self.selected_path = None
            self.selected_label = None

        self.selected_paths_list = result_paths
        self.selected_labels_list = result_labels
        self._shutdown()
        QApplication.instance().quit()

    def _on_cancel(self):
        self.selected_path = None
        self.selected_label = None
        self.selected_paths = set()
        self.selected_paths_list = []
        self.selected_labels_list = []
        self._shutdown()
        QApplication.instance().quit()

    def closeEvent(self, event):
        if not self._closing:
            self._on_cancel()
        event.accept()

    def _shutdown(self):
        if self._closing:
            return
        self._closing = True
        self._decode_stop.set()
        try:
            while True:
                self._decode_q.get_nowait()
        except queue.Empty:
            pass
        for _ in self._decode_threads:
            try:
                self._decode_q.put_nowait(None)
            except Exception:
                pass
        try:
            self._gallery_refresh_timer.stop()
        except Exception:
            pass
        try:
            self._resize_timer.stop()
        except Exception:
            pass

    # ── Lazy scanning ────────────────────────────────────────────────────────

    def start_lazy_scan(self, paths, recursive=False, sort_time=False):
        self._scan_done.clear()
        self._scan_thread = threading.Thread(
            target=self._scan_worker,
            args=(paths, recursive, sort_time),
            daemon=True
        )
        self._scan_thread.start()

    def _scan_worker(self, paths, recursive, sort_time):
        seen = set()
        for path in paths:
            if self._closing:
                break
            p = Path(path).expanduser().resolve()
            if not p.exists():
                continue
            if p.is_dir():
                pattern = "**/*" if recursive else "*"
                files = p.glob(pattern)
                if sort_time:
                    files = sorted(files, key=lambda x: x.stat().st_mtime, reverse=True)
                else:
                    files = sorted(files)
                for f in files:
                    if self._closing:
                        return
                    if f.suffix.lower() in SUPPORTED_EXTS and f not in seen:
                        seen.add(f)
                        try:
                            self._scan_bridge.file_found.emit(str(f))
                        except Exception:
                            pass
            elif p.is_file() and p.suffix.lower() in SUPPORTED_EXTS and str(p) not in seen:
                seen.add(str(p))
                try:
                    self._scan_bridge.file_found.emit(str(p))
                except Exception:
                    pass
        self._scan_done.set()

    # ── View switching ───────────────────────────────────────────────────────

    def _toggle_view(self):
        if self.view_mode == "list":
            self._show_gallery()
        else:
            self._show_list()

    def _show_list(self):
        self.view_mode = "list"
        self.stack.setCurrentIndex(0)
        self.input.setFocus()
        if self._last_index >= 0 and self.filtered_items:
            self._select_and_show(self._last_index, from_gallery=True)

    def _show_gallery(self):
        self.view_mode = "gallery"
        self.stack.setCurrentIndex(1)
        self._reset_gallery_tiles()
        self.input.setFocus()
        self._schedule_gallery_refresh(immediate=True)
        if self._last_index >= 0:
            self._scroll_gallery_to(self._last_index)
        self._base_status_text = (
            f"Gallery  |  {self._last_index + 1 if self._last_index >= 0 else 0}"
            f" / {len(self.filtered_items)}"
        )
        self.status_label.setText(
            f"{self._base_status_text}  |  {len(self.selected_paths)} selected"
        )

    # ── Lazy gallery ─────────────────────────────────────────────────────────

    def _schedule_gallery_refresh(self, immediate=False):
        if self._closing or self.view_mode != "gallery":
            return
        self._gallery_refresh_timer.stop()
        self._gallery_refresh_timer.start(0 if immediate else 50)

    def _on_gallery_canvas_resize(self):
        self._gallery_grid_dirty = True
        self._schedule_gallery_refresh(immediate=True)

    def _on_gallery_scroll(self, value):
        self._schedule_gallery_refresh()

    # ── Tile aspect ratio ────────────────────────────────────────────────────

    def _get_gallery_aspect(self):
        """Return the tile aspect ratio (width / height).

        Honours --gallery-aspect; otherwise samples the first few images
        and takes the median ratio so 16:9 screenshots don't waste space
        in square tiles. Result is cached.
        """
        if self._gallery_aspect_cache is not None:
            return self._gallery_aspect_cache

        a = None
        if self._gallery_aspect_opt is not None:
            a = float(self._gallery_aspect_opt)
        else:
            ratios = []
            for _label, path in self.all_items[:GALLERY_ASPECT_SAMPLE]:
                w, h = _get_orig_size(path)
                if w > 0 and h > 0:
                    ratios.append(w / h)
            if ratios:
                ratios.sort()
                a = ratios[len(ratios) // 2]

        if a is None or a <= 0:
            a = GALLERY_ASPECT_DEFAULT

        a = max(GALLERY_ASPECT_MIN, min(GALLERY_ASPECT_MAX, a))
        self._gallery_aspect_cache = a
        return a

    # ── Tile metrics ─────────────────────────────────────────────────────────

    def _compute_tile_metrics(self):
        """Return (tile_w, tile_h, caption_h, pad).

        Tiles are sized to match `aspect` (not forced square). The target
        number of visible rows/columns determines the tile's dimensions
        along each axis independently.
        """
        cw = self.gallery_canvas.viewport().width()
        ch = self.gallery_canvas.viewport().height()
        if cw <= 1 or ch <= 1:
            cw = max(self.width(), 1)
            ch = max(self.height(), 1)
        if cw <= 1 or ch <= 1:
            cw, ch = 1200, 800

        aspect = self._get_gallery_aspect()

        if self._gallery_tile_opt is not None:
            # Treat the option as a bound on the tile's long side.
            long_side = float(self._gallery_tile_opt)
            if aspect >= 1.0:
                base_w = long_side
                base_h = long_side / aspect
            else:
                base_h = long_side
                base_w = long_side * aspect
        else:
            rows = self._gallery_rows_opt or GALLERY_TARGET_ROWS
            # Approximate per-row vertical cost: tile_h * (1 + caption + pad)
            denom_v = 1.0 + GALLERY_CAPTION_RATIO + GALLERY_PAD_RATIO
            tile_h_from_rows = (ch / float(rows)) / denom_v
            tile_w_from_rows = tile_h_from_rows * aspect

            if self._gallery_cols_opt:
                denom_h = 1.0 + GALLERY_PAD_RATIO
                tile_w_from_cols = (cw / float(self._gallery_cols_opt)) / denom_h
                base_w = min(tile_w_from_rows, tile_w_from_cols)
            else:
                base_w = tile_w_from_rows
            base_h = base_w / aspect

        q = GALLERY_SIZE_QUANTUM
        tile_w = int(round(base_w / q)) * q
        tile_h = int(round(base_h / q)) * q
        tile_w = max(q, tile_w)
        tile_h = max(q, tile_h)

        # Clamp the long side to [MIN, MAX], preserving aspect.
        long_side = max(tile_w, tile_h)
        if long_side < GALLERY_TILE_MIN:
            scale = GALLERY_TILE_MIN / float(long_side)
            tile_w = max(q, int(round(tile_w * scale / q)) * q)
            tile_h = max(q, int(round(tile_h * scale / q)) * q)
        elif long_side > GALLERY_TILE_MAX:
            scale = GALLERY_TILE_MAX / float(long_side)
            tile_w = max(q, int(round(tile_w * scale / q)) * q)
            tile_h = max(q, int(round(tile_h * scale / q)) * q)

        pad = max(GALLERY_PAD_MIN, int(round(tile_h * GALLERY_PAD_RATIO)))
        cap = max(GALLERY_CAPTION_MIN, int(round(tile_h * GALLERY_CAPTION_RATIO)))
        return tile_w, tile_h, cap, pad

    def _update_tile_metrics(self):
        tw, th, cap, pad = self._compute_tile_metrics()
        if (tw, th, cap, pad) == (self._tile_w, self._tile_h,
                                  self._tile_caption_h, self._tile_pad):
            return False
        self._tile_w = tw
        self._tile_h = th
        self._tile_caption_h = cap
        self._tile_pad = pad
        self._tile_thumb_max = (max(1, tw - 5), max(1, th - 5))
        return True

    def _compute_cols(self):
        canvas_w = max(self.gallery_canvas.viewport().width(), 1)
        cols = max(1, (canvas_w - self._tile_pad) // (self._tile_w + self._tile_pad))
        return cols

    def _refresh_gallery(self):
        if self._closing or self.view_mode != "gallery":
            return

        if self._update_tile_metrics():
            # Tile size changed — recycle everything so tiles pick up new geometry.
            for tile in self._gallery_tiles.values():
                tile.setParent(None)
                tile.deleteLater()
            self._gallery_tiles.clear()
            self._gallery_gen += 1
            self._gallery_cols = 0  # force column recompute

        if not self.filtered_items:
            for tile in self._gallery_tiles.values():
                tile.setParent(None)
                tile.deleteLater()
            self._gallery_tiles.clear()
            self._gallery_built = True
            self._pending_gallery_scroll = None
            return

        vp = self.gallery_canvas.viewport()
        if vp.width() <= 1 or vp.height() <= 1:
            return

        cols = self._compute_cols()
        if cols != self._gallery_cols:
            self._gallery_cols = cols
            for tile in self._gallery_tiles.values():
                tile.setParent(None)
                tile.deleteLater()
            self._gallery_tiles.clear()
            self._gallery_gen += 1

        row_h = self._tile_h + self._tile_caption_h + self._tile_pad
        col_w = self._tile_w + self._tile_pad
        total_rows = (len(self.filtered_items) + cols - 1) // cols
        total_h = total_rows * row_h + self._tile_pad
        inner_w = cols * col_w + self._tile_pad

        self.gallery_inner.resize(max(inner_w, 1), max(total_h, 1))

        if self._pending_gallery_scroll is not None:
            idx = self._pending_gallery_scroll
            self._pending_gallery_scroll = None
            self._apply_gallery_scroll(idx)

        vp_h = vp.height()
        y_top = self.gallery_canvas.verticalScrollBar().value()
        first_row = max(0, int(y_top // row_h) - GALLERY_OVERSCAN_ROWS)
        last_row = min(total_rows - 1,
                       int((y_top + vp_h) // row_h) + GALLERY_OVERSCAN_ROWS)
        first_idx = first_row * cols
        last_idx = min(len(self.filtered_items), (last_row + 1) * cols)

        for idx in list(self._gallery_tiles.keys()):
            if idx < first_idx or idx >= last_idx:
                tile = self._gallery_tiles.pop(idx)
                tile.setParent(None)
                tile.deleteLater()

        tw, th = self._tile_thumb_max
        for idx in range(first_idx, last_idx):
            label, path = self.filtered_items[idx]
            tile = self._gallery_tiles.get(idx)
            needs_thumb = False

            if tile is None:
                tile = GalleryTile(self.gallery_inner, self, idx, label, path)
                r = idx // cols
                c = idx % cols
                tile.setGeometry(
                    c * col_w + self._tile_pad // 2,
                    r * row_h + self._tile_pad // 2,
                    self._tile_w,
                    self._tile_h + self._tile_caption_h
                )
                tile.show()
                self._gallery_tiles[idx] = tile
                needs_thumb = True
            elif tile.update_item(idx, label, path):
                needs_thumb = True

            tile.set_selected(path in self.selected_paths)
            tile.set_current(idx == self._last_index)

            if needs_thumb:
                # Pass the expected path so a late callback from a previous
                # item at this grid slot can't paint the wrong thumbnail.
                self._load_thumbnail_async(
                    path, tw, th,
                    lambda pix, orig, i=idx, p=path, g=self._gallery_gen:
                        self._on_gallery_thumb_ready(i, p, pix, g)
                )

        self._gallery_built = True

    def _on_gallery_thumb_ready(self, index, expected_path, pixmap, gen):
        if self._closing or gen != self._gallery_gen:
            return
        tile = self._gallery_tiles.get(index)
        if tile is None or tile.path != expected_path:
            return
        tile.set_photo(pixmap)

    def _update_gallery_selection(self, current_index):
        for idx, tile in self._gallery_tiles.items():
            if idx >= len(self.filtered_items):
                continue
            path = self.filtered_items[idx][1]
            tile.set_selected(path in self.selected_paths)
            tile.set_current(idx == current_index)

    def _scroll_gallery_to(self, index):
        if index < 0 or index >= len(self.filtered_items):
            return
        self._pending_gallery_scroll = index
        self._schedule_gallery_refresh(immediate=True)

    def _apply_gallery_scroll(self, index):
        """Move the canvas so that item `index` is fully inside the viewport.

        Must be called only from `_refresh_gallery`, after the scrollregion
        and gallery_inner geometry have been set for the current column count.
        """
        cols = max(self._gallery_cols, 1)
        row = index // cols
        row_h = self._tile_h + self._tile_caption_h + self._tile_pad
        row_top = row * row_h
        row_bottom = row_top + row_h

        vp_h = max(self.gallery_canvas.viewport().height(), 1)
        vbar = self.gallery_canvas.verticalScrollBar()
        y_top = vbar.value()
        y_bottom = y_top + vp_h

        if row_top < y_top:
            new_top = row_top
        elif row_bottom > y_bottom:
            new_top = row_bottom - vp_h
        else:
            return

        new_top = max(0, min(new_top, vbar.maximum()))
        vbar.setValue(new_top)

    # ── Gallery navigation ──
    def _gallery_cols_count(self):
        return max(1, self._gallery_cols)

    def _gallery_move_up(self):
        if not self.filtered_items:
            return
        idx = max(0, self._last_index - self._gallery_cols_count())
        self._select_and_show(idx, from_gallery=True)

    def _gallery_move_down(self):
        if not self.filtered_items:
            return
        idx = min(len(self.filtered_items) - 1,
                  self._last_index + self._gallery_cols_count())
        self._select_and_show(idx, from_gallery=True)

    def _gallery_move_left(self):
        if not self.filtered_items:
            return
        idx = max(0, self._last_index - 1)
        self._select_and_show(idx, from_gallery=True)

    def _gallery_move_right(self):
        if not self.filtered_items:
            return
        idx = min(len(self.filtered_items) - 1, self._last_index + 1)
        self._select_and_show(idx, from_gallery=True)

    def _gallery_page(self, direction):
        if not self.filtered_items:
            return
        cols = self._gallery_cols_count()
        vp_h = max(self.gallery_canvas.viewport().height(), 1)
        rows = max(1, vp_h // (self._tile_h + self._tile_caption_h + self._tile_pad))
        step = cols * rows * direction
        idx = max(0, min(len(self.filtered_items) - 1, self._last_index + step))
        self._select_and_show(idx, from_gallery=True)


# ─── Helpers ─────────────────────────────────────────────────────────────────

def collect_images(paths, recursive=False, sort_time=False):
    images = []
    seen = set()
    for path in paths:
        p = Path(path).expanduser().resolve()
        if p.is_dir():
            pattern = "**/*" if recursive else "*"
            files = p.glob(pattern)
            if sort_time:
                files = sorted(files, key=lambda x: x.stat().st_mtime, reverse=True)
            else:
                files = sorted(files)
            for f in files:
                if f.suffix.lower() in SUPPORTED_EXTS and f not in seen:
                    images.append(str(f))
                    seen.add(f)
        elif p.is_file() and p.suffix.lower() in SUPPORTED_EXTS and str(p) not in seen:
            images.append(str(p))
            seen.add(str(p))
    return images


def parse_args():
    parser = argparse.ArgumentParser(
        description="High-performance interactive image selector")
    parser.add_argument("paths", nargs="*", default=["."],
                        help="Directories or files to browse")
    parser.add_argument("-r", "--recursive", action="store_true",
                        help="Search recursively")
    parser.add_argument("-t", "--time", action="store_true",
                        help="Sort by modification time (newest first)")
    parser.add_argument("--lazy", action="store_true",
                        help="Lazy scan: show UI immediately, populate as files are found")
    parser.add_argument("--dmenu-mode", action="store_true",
                        help="Enable dmenu mode (list entries + image paths)")
    parser.add_argument("--list-file",
                        help="File containing newline-separated list entries")
    parser.add_argument("--list-entries",
                        help="Newline-separated list entries (as a string)")
    parser.add_argument("--image-file",
                        help="File containing newline-separated image file paths")
    parser.add_argument("--image-entries",
                        help="Newline-separated image file paths (as a string)")
    parser.add_argument("--pass-idx",
                        help="Pass the index to start the selector at")
    parser.add_argument("--idx-write-path",
                        help="File path to write the current index for debugging")
    parser.add_argument("--return-label", action="store_true",
                        help="In dmenu mode, output the selected list label instead of the image path")
    parser.add_argument("--pre-select",
                        help="Newline-separated labels to pre-select at launch")
    parser.add_argument("--custom-title", help="Title of the window")
    parser.add_argument("--pre-select-file",
                        help="File containing newline-separated labels to pre-select")
    parser.add_argument("--gallery", action="store_true",
                        help="Start in gallery view")
    parser.add_argument("--gallery-rows", type=float, default=None,
                        help="Target number of gallery rows visible (default 3.5)")
    parser.add_argument("--gallery-cols", type=int, default=None,
                        help="Target number of gallery columns visible")
    parser.add_argument("--gallery-tile-size", type=int, default=None,
                        help="Explicit gallery tile size in pixels (overrides rows/cols)")
    parser.add_argument("--gallery-aspect", type=float, default=None,
                        help="Gallery tile width/height ratio (default: "
                             "auto-detected from the images; e.g. 1.777 for 16:9)")
    return parser.parse_args()


def read_pre_select(args):
    if args.pre_select and args.pre_select_file:
        print("Error: both --pre-select and --pre-select-file provided.",
              file=sys.stderr)
        sys.exit(1)
    if args.pre_select_file:
        try:
            with open(args.pre_select_file, 'r') as f:
                return [line.rstrip('\n') for line in f]
        except Exception as e:
            print(f"Error reading pre-select file: {e}", file=sys.stderr)
            sys.exit(1)
    if args.pre_select:
        return args.pre_select.split('\n')
    return None


def _emit_result(app, return_label):
    if app.selected_paths_list:
        if return_label:
            for label in app.selected_labels_list:
                print(label)
        else:
            for path in app.selected_paths_list:
                print(path)
        sys.stdout.flush()
        os._exit(0)
    elif app.selected_path is not None:
        if return_label:
            print(app.selected_label)
        else:
            print(app.selected_path)
        sys.stdout.flush()
        os._exit(0)
    else:
        os._exit(1)


# ─── Entry point ─────────────────────────────────────────────────────────────

def main():
    args = parse_args()
    pre_select_labels = read_pre_select(args)
    custom_title = args.custom_title or ""
    pass_idx = int(args.pass_idx) if args.pass_idx else 0
    idx_write_path = args.idx_write_path or ""

    qapp = QApplication(sys.argv)
    try:
        qapp.setStyle("Fusion")
    except Exception:
        pass

    if args.dmenu_mode:
        if args.list_file and args.list_entries:
            print("Error: both --list-file and --list-entries provided.",
                  file=sys.stderr)
            sys.exit(1)
        if args.list_file:
            try:
                with open(args.list_file, 'r') as f:
                    list_entries = [line.rstrip('\n') for line in f]
            except Exception as e:
                print(f"Error reading list file: {e}", file=sys.stderr)
                sys.exit(1)
        elif args.list_entries:
            list_entries = args.list_entries.split('\n')
        else:
            print("Error: must provide either --list-file or --list-entries",
                  file=sys.stderr)
            sys.exit(1)

        if args.image_file and args.image_entries:
            print("Error: both --image-file and --image-entries provided.",
                  file=sys.stderr)
            sys.exit(1)
        if args.image_file:
            try:
                with open(args.image_file, 'r') as f:
                    image_entries = [line.rstrip('\n') for line in f]
            except Exception as e:
                print(f"Error reading image file: {e}", file=sys.stderr)
                sys.exit(1)
        elif args.image_entries:
            image_entries = args.image_entries.split('\n')
        else:
            print("Error: must provide either --image-file or --image-entries",
                  file=sys.stderr)
            sys.exit(1)

        if len(list_entries) != len(image_entries):
            print(f"Error: number of list entries ({len(list_entries)}) and "
                  f"image entries ({len(image_entries)}) do not match",
                  file=sys.stderr)
            sys.exit(1)

        app = ImageSelector(
            image_entries, display_labels=list_entries,
            pre_select_labels=pre_select_labels,
            pass_idx=pass_idx, idx_write_path=idx_write_path,
            custom_title=custom_title,
            gallery_rows=args.gallery_rows,
            gallery_cols=args.gallery_cols,
            gallery_tile_size=args.gallery_tile_size,
            gallery_aspect=args.gallery_aspect,
        )
        app.show()
        if args.gallery:
            app._show_gallery()
        rc = qapp.exec()
        if rc == 99:
            os._exit(99)
        _emit_result(app, args.return_label)
        return

    if args.lazy:
        app = ImageSelector(
            [], pre_select_labels=pre_select_labels,
            pass_idx=pass_idx, idx_write_path=idx_write_path,
            custom_title=custom_title,
            gallery_rows=args.gallery_rows,
            gallery_cols=args.gallery_cols,
            gallery_tile_size=args.gallery_tile_size,
            gallery_aspect=args.gallery_aspect,
        )
        app.show()
        if args.gallery:
            app._show_gallery()
        app.start_lazy_scan(args.paths, recursive=args.recursive,
                            sort_time=args.time)
        rc = qapp.exec()
        if rc == 99:
            os._exit(99)
    else:
        images = collect_images(args.paths, recursive=args.recursive,
                                sort_time=args.time)
        if not images:
            print("No images found.", file=sys.stderr)
            sys.exit(1)

        app = ImageSelector(
            images, pre_select_labels=pre_select_labels,
            pass_idx=pass_idx, idx_write_path=idx_write_path,
            custom_title=custom_title,
            gallery_rows=args.gallery_rows,
            gallery_cols=args.gallery_cols,
            gallery_tile_size=args.gallery_tile_size,
            gallery_aspect=args.gallery_aspect,
        )
        app.show()
        if args.gallery:
            app._show_gallery()
        rc = qapp.exec()
        if rc == 99:
            os._exit(99)

    if app.selected_paths_list:
        for path in app.selected_paths_list:
            print(path)
        sys.stdout.flush()
        os._exit(0)
    elif app.selected_path is not None:
        print(app.selected_path)
        sys.stdout.flush()
        os._exit(0)
    else:
        os._exit(1)


if __name__ == "__main__":
    main()
