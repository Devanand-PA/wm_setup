#!/usr/bin/env python3
"""
High-performance image selector with async loading, thumbnail caching,
and lazy directory scanning.
Usage:
    sel_img.py [directory...] [-r] [-t]
    -r  : recursively search subdirectories
    -t  : sort by modification time (newest first)
"""

import sys
import os
import argparse
import threading
from pathlib import Path
from concurrent.futures import ThreadPoolExecutor, Future
from functools import lru_cache
from collections import deque
from tkinter import Tk, Frame, Listbox, Entry, Label, Scrollbar, StringVar
from tkinter import BOTH, LEFT, RIGHT, TOP, BOTTOM, X, Y, END, SINGLE
from PIL import Image, ImageTk

# ─── Configuration ───────────────────────────────────────────────────────────

SUPPORTED_EXTS = {'.png', '.jpg', '.jpeg', '.gif', '.bmp', '.webp', '.tiff', '.tif'}

THEME = {
    "bg_primary":   "#2e3440",
    "bg_secondary": "#3b4252",
    "bg_input":     "#4c566a",
    "fg_text":      "#d8dee9",
    "fg_bright":    "#eceff4",
    "accent":       "#88c0d0",
    "accent_fg":    "#2e3440",
}

CACHE_SIZE = 100          # Max cached thumbnails
PRELOAD_AHEAD = 3         # How many images to preload ahead/behind
MAX_WORKERS = 4           # Background threads for image loading

# ─── Caching ─────────────────────────────────────────────────────────────────

@lru_cache(maxsize=CACHE_SIZE)
def _load_thumbnail(path: str, max_w: int, max_h: int) -> ImageTk.PhotoImage:
    """Load and resize an image in a background thread. Cached by path + size."""
    try:
        with Image.open(path) as img:
            # thumbnail() is faster than resize() for previews and preserves aspect ratio
            img.thumbnail((max_w, max_h), Image.LANCZOS)
            # Convert to RGB/RGBA to avoid palette issues, then copy to detach from file
            if img.mode in ('P', 'LA', 'L'):
                img = img.convert('RGBA' if 'A' in img.mode or img.mode == 'LA' else 'RGB')
            return ImageTk.PhotoImage(img)
    except Exception:
        return None


# ─── Main Application ────────────────────────────────────────────────────────

class ImageSelector:
    def __init__(self, root, image_paths):
        self.root = root
        self.all_images = list(image_paths)   # May be populated lazily
        self.filtered_images = list(image_paths)
        self._pending_future = None           # Current background load
        self._executor = ThreadPoolExecutor(max_workers=MAX_WORKERS)
        self._preload_queue = deque(maxlen=PRELOAD_AHEAD * 2 + 1)
        self._last_index = -1
        self._after_id = None
        self._scan_thread = None
        self._scan_done = threading.Event()
        self._scan_done.set()

        self._setup_window()
        self._build_ui()
        self._bind_events()
        self._populate_list()
        if self.filtered_images:
            self._select_and_show(0)
        self.input.focus_set()

    def _setup_window(self):
        self.root.title("Image Selector")
        self.root.configure(bg=THEME["bg_primary"])
        self.root.attributes('-topmost', True)
        try:
            self.root.attributes('-type', 'dialog')
        except Exception:
            pass
        sw = self.root.winfo_screenwidth()
        sh = self.root.winfo_screenheight()
        self.root.geometry(f"{sw - 100}x{sh - 100}+50+50")
        self.root.minsize(600, 400)

    def _build_ui(self):
        self.main_frame = Frame(self.root, bg=THEME["bg_primary"])
        self.main_frame.pack(fill=BOTH, expand=True, padx=10, pady=10)

        # ── Left Panel ──
        self.left_frame = Frame(self.main_frame, bg=THEME["bg_primary"], width=300)
        self.left_frame.pack(side=LEFT, fill=BOTH, expand=False)
        self.left_frame.pack_propagate(False)

        self.search_var = StringVar()
        self.search_var.trace_add("write", self._on_search)
        self.input = Entry(
            self.left_frame,
            textvariable=self.search_var,
            bg=THEME["bg_input"],
            fg=THEME["fg_text"],
            insertbackground=THEME["fg_text"],
            highlightthickness=1,
            highlightbackground=THEME["bg_secondary"],
            highlightcolor=THEME["accent"],
            relief="flat",
            font=("sans-serif", 12)
        )
        self.input.pack(side=BOTTOM, fill=X, pady=(5, 0))

        list_container = Frame(self.left_frame, bg=THEME["bg_primary"])
        list_container.pack(side=TOP, fill=BOTH, expand=True)

        scrollbar = Scrollbar(list_container, bg=THEME["bg_secondary"])
        scrollbar.pack(side=RIGHT, fill=Y)

        self.listbox = Listbox(
            list_container,
            selectmode=SINGLE,
            bg=THEME["bg_secondary"],
            fg=THEME["fg_text"],
            selectbackground=THEME["accent"],
            selectforeground=THEME["accent_fg"],
            borderwidth=0,
            highlightthickness=0,
            font=("sans-serif", 11),
            activestyle="none",
            yscrollcommand=scrollbar.set
        )
        self.listbox.pack(side=LEFT, fill=BOTH, expand=True)
        scrollbar.config(command=self.listbox.yview)

        # ── Right Panel ──
        self.right_frame = Frame(self.main_frame, bg=THEME["bg_primary"])
        self.right_frame.pack(side=LEFT, fill=BOTH, expand=True, padx=(10, 0))

        self.filename_label = Label(
            self.right_frame,
            bg=THEME["bg_primary"],
            fg=THEME["fg_bright"],
            font=("sans-serif", 12, "bold"),
            anchor="w"
        )
        self.filename_label.pack(side=TOP, fill=X, pady=(0, 5))

        self.image_container = Frame(self.right_frame, bg=THEME["bg_secondary"])
        self.image_container.pack(fill=BOTH, expand=True)

        self.image_label = Label(
            self.image_container,
            bg=THEME["bg_secondary"],
            text="Loading...",
            fg=THEME["fg_text"],
            font=("sans-serif", 14)
        )
        self.image_label.place(relx=0.5, rely=0.5, anchor="center")

        self.status_label = Label(
            self.right_frame,
            bg=THEME["bg_primary"],
            fg=THEME["fg_text"],
            font=("sans-serif", 10),
            anchor="e"
        )
        self.status_label.pack(side=BOTTOM, fill=X, pady=(5, 0))

    def _bind_events(self):
        self.listbox.bind("<<ListboxSelect>>", self._on_list_select)
        self.listbox.bind("<Double-Button-1>", self._on_confirm)

        for widget in (self.input, self.listbox):
            widget.bind("<Up>", self._focus_list_up)
            widget.bind("<Down>", self._focus_list_down)

        self.input.bind("<Return>", self._on_confirm)
        self.input.bind("<Escape>", self._on_cancel)
        self.listbox.bind("<Return>", self._on_confirm)
        self.listbox.bind("<Escape>", self._on_cancel)

        self.listbox.bind("<Key>", self._refocus_input)
        self.listbox.bind("<MouseWheel>", self._on_mousewheel)
        self.root.bind("<MouseWheel>", self._on_mousewheel)
        self.image_container.bind("<Configure>", self._on_container_resize)

    def _populate_list(self):
        self.listbox.delete(0, END)
        for path in self.filtered_images:
            self.listbox.insert(END, os.path.basename(path))
        if self.filtered_images:
            self.listbox.select_set(0)

    def _append_to_list(self, path):
        """Thread-safe append for lazy scanning."""
        self.filtered_images.append(path)
        self.all_images.append(path)
        idx = len(self.filtered_images) - 1
        self.listbox.insert(END, os.path.basename(path))
        # Auto-select first item if nothing selected yet
        if idx == 0:
            self.listbox.select_set(0)
            self._select_and_show(0)

    # ── Search ───────────────────────────────────────────────────────────────

    def _on_search(self, *args):
        query = self.search_var.get().lower().strip()
        terms = query.split() if query else []

        self.filtered_images = [
            path for path in self.all_images
            if not terms or all(term in os.path.basename(path).lower() for term in terms)
        ]

        self._populate_list()
        if self.filtered_images:
            self._select_and_show(0)
        else:
            self._last_index = -1
            self.filename_label.config(text="No matches")
            self.image_label.config(image="", text="No matches")
            self.status_label.config(text="0 images")

    # ── Selection & Display ──────────────────────────────────────────────────

    def _on_list_select(self, event=None):
        sel = self.listbox.curselection()
        if sel:
            self._select_and_show(sel[0])

    def _select_and_show(self, index):
        if not self.filtered_images:
            return
        index = max(0, min(index, len(self.filtered_images) - 1))
        if index == self._last_index:
            return

        self.listbox.selection_clear(0, END)
        self.listbox.select_set(index)
        self.listbox.see(index)

        self._last_index = index
        path = self.filtered_images[index]
        self.filename_label.config(text=os.path.basename(path))
        self.image_label.config(image="", text="Loading...")
        self.status_label.config(text=f"Loading...  |  {index + 1} / {len(self.filtered_images)}")

        # Cancel any pending load
        if self._pending_future and not self._pending_future.done():
            self._pending_future.cancel()

        # Load in background thread
        self._pending_future = self._executor.submit(
            self._load_image_thread, path, index
        )
        self._pending_future.add_done_callback(
            lambda f, idx=index: self._on_image_loaded(f, idx)
        )

        # Preload neighbors
        self._preload_neighbors(index)

    def _load_image_thread(self, path, index):
        """Runs in background thread. Returns (photo, w, h, size_kb) or None."""
        try:
            # Get container size (cached at call time in main thread, passed here)
            cw = max(self.image_container.winfo_width() - 20, 50)
            ch = max(self.image_container.winfo_height() - 20, 50)
            photo = _load_thumbnail(path, cw, ch)
            if photo is None:
                return None
            # Get dimensions from original file without reopening if possible
            with Image.open(path) as img:
                w, h = img.size
            size_kb = os.path.getsize(path) / 1024
            return (photo, w, h, size_kb)
        except Exception as e:
            return ("error", str(e))

    def _on_image_loaded(self, future, expected_index):
        """Called on main thread when image load completes."""
        if expected_index != self._last_index:
            return  # User already moved on
        try:
            result = future.result()
            if result is None:
                self.image_label.config(image="", text="Failed to load")
                self.status_label.config(text="Error loading image")
                return
            if result[0] == "error":
                self.image_label.config(image="", text=f"Error: {result[1]}")
                self.status_label.config(text=f"Error: {result[1]}")
                return

            photo, w, h, size_kb = result
            self.image_label.config(image=photo, text="")
            self.image_label.image = photo  # Keep reference
            self.status_label.config(
                text=f"{w}×{h}  |  {size_kb:.1f} KB  |  {expected_index + 1} / {len(self.filtered_images)}"
            )
        except Exception as e:
            self.status_label.config(text=f"Error: {e}")

    def _preload_neighbors(self, center_index):
        """Warm the cache for images around the current one."""
        for offset in range(-PRELOAD_AHEAD, PRELOAD_AHEAD + 1):
            if offset == 0:
                continue
            idx = center_index + offset
            if 0 <= idx < len(self.filtered_images):
                path = self.filtered_images[idx]
                cw = max(self.image_container.winfo_width() - 20, 50)
                ch = max(self.image_container.winfo_height() - 20, 50)
                # Submit to executor; result goes to cache, we ignore the future
                self._executor.submit(_load_thumbnail, path, cw, ch)

    def _on_container_resize(self, event=None):
        if self._after_id:
            self.root.after_cancel(self._after_id)
        self._after_id = self.root.after(150, self._on_resize_done)

    def _on_resize_done(self):
        """Re-display current image at new size when container resizes."""
        if self._last_index >= 0 and self.filtered_images:
            # Force cache miss for new size by clearing just this entry
            # Actually lru_cache keys include size, so new size auto-misses
            self._select_and_show(self._last_index)

    # ── Navigation ───────────────────────────────────────────────────────────

    def _focus_list_up(self, event=None):
        if self.listbox.size() == 0:
            return "break"
        self.listbox.focus_set()
        curr = self.listbox.curselection()
        idx = curr[0] if curr else 0
        new_idx = (idx - 1) % self.listbox.size()
        self._select_and_show(new_idx)
        return "break"

    def _focus_list_down(self, event=None):
        if self.listbox.size() == 0:
            return "break"
        self.listbox.focus_set()
        curr = self.listbox.curselection()
        idx = curr[0] if curr else 0
        new_idx = (idx + 1) % self.listbox.size()
        self._select_and_show(new_idx)
        return "break"

    def _refocus_input(self, event=None):
        if event and len(event.char) == 1 and event.char.isprintable():
            self.search_var.set(self.search_var.get() + event.char)
            self.input.focus_set()
            self.input.icursor(END)
            return "break"

    def _on_mousewheel(self, event=None):
        if event and self.listbox.winfo_exists():
            self.listbox.yview_scroll(int(-1 * (event.delta / 120)), "units")

    def _on_confirm(self, event=None):
        sel = self.listbox.curselection()
        if sel and self.filtered_images:
            self.selected = self.filtered_images[sel[0]]
            self._shutdown()
            self.root.quit()

    def _on_cancel(self, event=None):
        self.selected = None
        self._shutdown()
        self.root.quit()

    def _shutdown(self):
        self._executor.shutdown(wait=False)

    # ── Lazy Scanning (optional, used when scanning large dirs) ──────────────

    def start_lazy_scan(self, paths, recursive=False, sort_time=False):
        """Start background thread to scan directories lazily."""
        self._scan_done.clear()
        self._scan_thread = threading.Thread(
            target=self._scan_worker,
            args=(paths, recursive, sort_time),
            daemon=True
        )
        self._scan_thread.start()

    def _scan_worker(self, paths, recursive, sort_time):
        seen = set()
        for path in paths:
            p = Path(path).expanduser().resolve()
            if not p.exists():
                continue
            if p.is_dir():
                pattern = "**/*" if recursive else "*"
                files = p.glob(pattern)
                if sort_time:
                    files = sorted(files, key=lambda x: x.stat().st_mtime, reverse=True)
                else:
                    files = sorted(files)
                for f in files:
                    if f.suffix.lower() in SUPPORTED_EXTS and f not in seen:
                        seen.add(f)
                        # Schedule UI update on main thread
                        self.root.after(0, lambda fp=str(f): self._append_to_list(fp))
            elif p.is_file() and p.suffix.lower() in SUPPORTED_EXTS and str(p) not in seen:
                seen.add(str(p))
                self.root.after(0, lambda fp=str(p): self._append_to_list(fp))
        self._scan_done.set()


# ─── Helpers ─────────────────────────────────────────────────────────────────

def collect_images(paths, recursive=False, sort_time=False):
    images = []
    seen = set()
    for path in paths:
        p = Path(path).expanduser().resolve()
        if p.is_dir():
            pattern = "**/*" if recursive else "*"
            files = p.glob(pattern)
            files = sorted(files, key=lambda x: x.stat().st_mtime, reverse=True) if sort_time else sorted(files)
            for f in files:
                if f.suffix.lower() in SUPPORTED_EXTS and f not in seen:
                    images.append(str(f))
                    seen.add(f)
        elif p.is_file() and p.suffix.lower() in SUPPORTED_EXTS and str(p) not in seen:
            images.append(str(p))
            seen.add(str(p))
    return images


def parse_args():
    parser = argparse.ArgumentParser(description="High-performance interactive image selector")
    parser.add_argument("paths", nargs="*", default=["."], help="Directories or files to browse")
    parser.add_argument("-r", "--recursive", action="store_true", help="Search recursively")
    parser.add_argument("-t", "--time", action="store_true", help="Sort by modification time (newest first)")
    parser.add_argument("--lazy", action="store_true", help="Lazy scan: show UI immediately, populate as files are found")
    return parser.parse_args()


# ─── Entry Point ─────────────────────────────────────────────────────────────

def main():
    args = parse_args()
    paths = args.paths if args.paths else ["."]

    if args.lazy:
        # Start UI immediately with empty list, scan in background
        root = Tk()
        app = ImageSelector(root, [])
        app.start_lazy_scan(paths, recursive=args.recursive, sort_time=args.time)
        root.mainloop()
    else:
        # Traditional: scan first, then show UI
        images = collect_images(paths, recursive=args.recursive, sort_time=args.time)
        if not images:
            print("No images found.", file=sys.stderr)
            sys.exit(1)

        root = Tk()
        app = ImageSelector(root, images)
        root.mainloop()

    if hasattr(app, 'selected') and app.selected:
        print(app.selected)
        sys.exit(0)
    else:
        sys.exit(1)


if __name__ == "__main__":
    main()
